# Porta HTTP/WebSocket do servidor de jogo
PORT=2567

# LiveKit (voz por proximidade). Deixe vazio para jogar sem voz.
# Local (docker / livekit-server --dev): LIVEKIT_URL=ws://localhost:7880  KEY=devkey  SECRET=secret
# Cloud: LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opcional: URL que o NAVEGADOR usa, se diferente da interna (ex.: docker)
LIVEKIT_PUBLIC_URL=

# Grava o log de eventos de cada partida em server/logs/*.jsonl
EVENT_LOG_TO_FILE=true
