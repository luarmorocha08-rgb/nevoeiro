{
  "name": "@nevoeiro/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Nevoeiro — cliente 3D (web, PWA, Capacitor e Electron)",
  "author": "Nevoeiro",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p .",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.1.0",
    "colyseus.js": "0.15.28",
    "livekit-client": "^2.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@nevoeiro/shared": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.nevoeiro.game",
    "productName": "Nevoeiro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  }
}
